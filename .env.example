# TAMIL-LEARN Environment Configuration Template
# Duplicate this file to .env.local for local development.
# NEVER commit .env, .env.local, or real credentials to source control.

# Signed session encryption key (min 32 characters)
SESSION_SECRET="replace_with_a_secure_random_key_of_at_least_32_characters"

# Primary Lakebase PostgreSQL Connection (Pooled endpoint)
DATABASE_URL="postgresql://username:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"

# Direct Lakebase PostgreSQL Connection (Unpooled endpoint for migrations)
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-example.region.neon.tech/neondb?sslmode=require"

# Isolated Test Database (Used for Playwright and integration suites)
TEST_DATABASE_URL="postgresql://username:password@ep-test-pooler.region.neon.tech/neondb?sslmode=require"

# Target Neon Branch
NEON_BRANCH=development
